{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated trader profile stored under private user scope.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "WatchlistItem": {
      "title": "WatchlistItem",
      "description": "A cryptocurrency pair tracked by the user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "symbol": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "coinName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "symbol", "coinName", "createdAt"]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "User-configured target price alert for a crypto pair.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "symbol": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]+$"
        },
        "condition": {
          "type": "string",
          "enum": ["ABOVE", "BELOW"]
        },
        "targetPrice": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "triggered": {
          "type": "boolean"
        },
        "emailNotify": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "symbol",
        "condition",
        "targetPrice",
        "active",
        "triggered",
        "emailNotify",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceControlConfig": {
      "title": "WorkspaceControlConfig",
      "description": "Persistent granular microservice control toggle matrix scoped strictly to verified owner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "checksum": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "toggles": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "checksum", "toggles", "createdAt", "updatedAt"]
    },
    "RollbackCheckpoint": {
      "title": "RollbackCheckpoint",
      "description": "Immutable configuration snapshot checkpoint for automated/manual rollback.",
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "checksum": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "toggles": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["snapshotId", "userId", "version", "reason", "checksum", "toggles", "createdAt"]
    },
    "ErrorAuditRecord": {
      "title": "ErrorAuditRecord",
      "description": "Structured PII-masked microservice error event stored for operator forensics.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "serviceId": {
          "type": "string",
          "enum": [
            "market-data-svc",
            "ai-agents-svc",
            "execution-router-svc",
            "risk-kernel-svc",
            "telemetry-bus-svc"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["WARN", "ERROR", "CRITICAL"]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "recoveryAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "correlationId",
        "serviceId",
        "severity",
        "code",
        "message",
        "recoveryAction",
        "createdAt"
      ]
    },
    "DailyPnlRecord": {
      "title": "DailyPnlRecord",
      "description": "High-precision daily realized PnL and percentage return ledger scoped strictly to verified owner.",
      "type": "object",
      "properties": {
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "startingEquityUsd": { "type": "number" },
        "endingEquityUsd": { "type": "number" },
        "realizedPnlUsd": { "type": "number" },
        "returnPct": { "type": "number" },
        "scoopedToVaultUsd": { "type": "number" },
        "manualReleasedUsd": { "type": "number" },
        "tradeCount": { "type": "number" },
        "winningTrades": { "type": "number" },
        "losingTrades": { "type": "number" },
        "winRatePct": { "type": "number" },
        "recordHash": {
          "type": "string",
          "minLength": 8,
          "maxLength": 32
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "dateKey",
        "userId",
        "startingEquityUsd",
        "endingEquityUsd",
        "realizedPnlUsd",
        "returnPct",
        "scoopedToVaultUsd",
        "manualReleasedUsd",
        "tradeCount",
        "winningTrades",
        "losingTrades",
        "winRatePct",
        "recordHash",
        "createdAt",
        "updatedAt"
      ]
    },
    "VaultLockerState": {
      "title": "VaultLockerState",
      "description": "User-scoped immutable Locker Vault balance and scooping threshold configuration snapshot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "thresholdMode": {
          "type": "string",
          "enum": ["USD_FIXED", "PERCENT_OF_EQUITY"]
        },
        "profitThresholdUsd": { "type": "number" },
        "profitThresholdPct": { "type": "number" },
        "scoopExcessRatioPct": { "type": "number" },
        "enabled": { "type": "boolean" },
        "lockedVaultBalanceUsd": { "type": "number" },
        "totalScoopedLifetimeUsd": { "type": "number" },
        "stateVersion": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "thresholdMode",
        "profitThresholdUsd",
        "profitThresholdPct",
        "scoopExcessRatioPct",
        "enabled",
        "lockedVaultBalanceUsd",
        "totalScoopedLifetimeUsd",
        "stateVersion",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile isolated to the authenticated owner."
    },
    "/users/{userId}/watchlist/{coinId}": {
      "schema": { "$ref": "#/entities/WatchlistItem" },
      "description": "User watchlist coins."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "User price alerts."
    },
    "/users/{userId}/workspaceConfig/{configId}": {
      "schema": { "$ref": "#/entities/WorkspaceControlConfig" },
      "description": "Persistent granular microservice control toggle matrix."
    },
    "/users/{userId}/rollbackSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/RollbackCheckpoint" },
      "description": "Immutable configuration rollback checkpoints."
    },
    "/users/{userId}/errorLogs/{logId}": {
      "schema": { "$ref": "#/entities/ErrorAuditRecord" },
      "description": "Structured PII-masked microservice error logs."
    },
    "/users/{userId}/dailyPnlRecords/{dateKey}": {
      "schema": { "$ref": "#/entities/DailyPnlRecord" },
      "description": "Legacy unverified browser-authored research PnL records; read-only to clients, never authoritative settlement."
    },
    "/users/{userId}/vaultLocker/{vaultId}": {
      "schema": { "$ref": "#/entities/VaultLockerState" },
      "description": "Legacy unverified browser-authored vault snapshot; read-only to clients, never verified personal funds."
    }
  }
}

{
  "bot_name": "SignalForge-Freqtrade-Core",
  "trading_mode": "PAPER_DRY_RUN",
  "allowed_modes": ["TESTNET", "PAPER_DRY_RUN", "LIVE"],
  "dry_run_wallet_usd": 10000.0,
  "sqlite_db_path": ".data/signal_forge_dry_run.sqlite",
  "exchange": {
    "name": "binance",
    "supported_exchanges": ["binance", "bybit", "okx", "kraken"],
    "market_type": "SPOT",
    "enable_rate_limit": true,
    "timeout_ms": 10000,
    "api_key_env": "EXCHANGE_API_KEY",
    "api_secret_env": "EXCHANGE_API_SECRET",
    "pair_whitelist": ["BTC/USDT", "ETH/USDT", "SOL/USDT", "BNB/USDT", "AVAX/USDT"]
  },
  "risk_management": {
    "stop_loss_pct": 0.02,
    "take_profit_pct": 0.06,
    "trailing_stop_enabled": true,
    "trailing_stop_activation_pct": 0.015,
    "trailing_stop_offset_pct": 0.008,
    "max_daily_drawdown_pct": 0.08,
    "max_open_trades": 5,
    "stake_fraction_per_trade": 0.15,
    "required_consecutive_profitable_paper_trades": 50
  },
  "telegram_rpc": {
    "enabled": true,
    "bot_token_env": "TELEGRAM_BOT_TOKEN",
    "chat_id_env": "TELEGRAM_AUDIT_CHAT_ID",
    "commands": ["/start", "/stop", "/status", "/profit"],
    "audit_interval_seconds": 60
  },
  "notifications": {
    "discord": {
      "enabled": false,
      "webhook_url_env": "DISCORD_WEBHOOK_URL",
      "bot_token_env": "DISCORD_BOT_TOKEN",
      "channel_id_env": "DISCORD_CHANNEL_ID",
      "notify_on_entry": true,
      "notify_on_exit": true,
      "notify_on_halt": true
    }
  }
}

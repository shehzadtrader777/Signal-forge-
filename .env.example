# ==============================================================================
# SIGNAL FORGE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy to .env for local development. NEVER commit real secrets, API keys,
# personal email addresses, or private tokens into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEVELOPMENT & RUNTIME DEFAULTS (safe defaults exist if omitted)
# ------------------------------------------------------------------------------
APP_URL="https://your-signal-forge-domain.example.com"
GEMINI_MODEL_PRIMARY="gemini-3.8-live"
GEMINI_MODEL_REASONING="gemini-3.1-pro-preview"
RATE_LIMIT_RPM="200"
RATE_LIMIT_BURST="50"
VAULT_UNLOCK_HOURS="6"

# ------------------------------------------------------------------------------
# 2. OPTIONAL AI & MARKET INTELLIGENCE INTEGRATIONS (server-side only)
# Application boots cleanly when these are left empty.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
COINGECKO_API_KEY=""
COINGECKO_API_TIER="demo"
CMC_API_KEY=""
CRYPTOPANIC_API_KEY=""
LUNARCRUSH_API_KEY=""
OPENAI_COMPAT_API_KEY=""
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 3. OPTIONAL EMAIL OTP & OWNER ALERTS (Resend — server-side only)
# Configure a verified domain in RESEND_FROM_EMAIL before enabling Email OTP.
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Signal Forge <alerts@yourdomain.example.com>"
OWNER_ALERT_EMAIL="owner@example.com"
ADMIN_EMAIL_ALLOWLIST=""
OPERATOR_API_TOKEN=""
PUBLIC_WHATSAPP_URL=""
VITE_PUBLIC_SUPPORT_EMAIL="support@signalforge.app"

# ------------------------------------------------------------------------------
# 4. OPTIONAL TELEGRAM, MAKE.COM & DISCORD DELIVERY (server-side only)
# Use canonical names below; never paste a Telegram Bot Token into TELEGRAM_CHAT_ID
# or TELEGRAM_WEBHOOK_SECRET, and never set TELEGRAM_DEV_CHAT_ID to a -100 channel ID.
# TELEGRAM_WEBHOOK_SECRET must be a separate 16-256 char [A-Za-z0-9_-] secret.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_DEV_CHAT_ID=""
TELEGRAM_CHANNEL_ID=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_DAILY_AUDIT_UTC_HOUR="0"
MAKE_WEBHOOK_URL=""

DISCORD_WEBHOOK_URL=""
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""

# ------------------------------------------------------------------------------
# 5. OPTIONAL EXCHANGE DEMO / SANDBOX CREDENTIALS (server-side only)
# Real-money live trading remains strictly LOCKED by default.
# ------------------------------------------------------------------------------
OKX_API_KEY=""
OKX_API_SECRET=""
OKX_PASSPHRASE=""
OKX_DEMO_MODE="true"

BINANCE_TESTNET_API_KEY=""
BINANCE_TESTNET_SECRET=""

# Reserved for future authorized live deployment (keep empty in Paper/Demo mode)
BINANCE_LIVE_API_KEY=""
BINANCE_LIVE_SECRET=""

# Optional additional exchange connectors (disabled cleanly when unset)
BYBIT_API_KEY=""
BYBIT_API_SECRET=""
KRAKEN_API_KEY=""
KRAKEN_API_SECRET=""

# Optional unified CCXT / Freqtrade dry-run configuration
EXCHANGE_ID="binance"
EXCHANGE_API_KEY=""
EXCHANGE_API_SECRET=""

# ------------------------------------------------------------------------------
# 6. OPTIONAL CONTAINMENT & BOT PROTECTION (server-side secrets + public site key)
# ------------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=""
CONTAINMENT_BINDING_SECRET=""
ROTATING_PROXY_POOL_URLS=""

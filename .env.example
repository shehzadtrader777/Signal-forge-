# Signal Forge development environment template
# Copy to .env locally. Never commit a populated .env file.
# Every value here is illustrative or blank. Store real secrets in protected server-side secrets.
GEMINI_API_KEY=""
GEMINI_MODEL_PRIMARY=""
GEMINI_MODEL_REASONING=""
RATE_LIMIT_RPM="200"
RATE_LIMIT_BURST="50"
VAULT_UNLOCK_HOURS="6"
APP_URL="http://localhost:3000"

# SECURITY: Do not define VITE_CMC_API_KEY; VITE_ values are embedded in the browser bundle.
# Use the server-only CMC_API_KEY below with an authenticated server-side proxy.
# CoinMarketCap integration must remain disabled until the server proxy is reviewed.

CRYPTOPANIC_API_KEY=""
LUNARCRUSH_API_KEY=""
RESEND_API_KEY=""
OWNER_ALERT_EMAIL=""
RECIPIENT_EMAIL=""

BOT_TOKEN=""
CHAT_ID=""
DEVELOPER_CHAT_ID=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_DEV_CHAT_ID=""
TELEGRAM_CHANNEL_ID=""
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_DAILY_AUDIT_UTC_HOUR="0"
MAKE_WEBHOOK_URL=""
WEBHOOK_BOT_TOKEN=""

# LOCAL RESEARCH ONLY: server denies browser-submitted manual PnL in production,
# regardless of this setting. Set true only in an isolated development sandbox.
ALLOW_UNVERIFIED_VAULT_GAIN_DEMO=false

# Testnet only until live integrations pass independent security review.
BINANCE_TESTNET_API_KEY=""
BINANCE_TESTNET_SECRET=""
BINANCE_LIVE_API_KEY=""
BINANCE_LIVE_SECRET=""

OPENAI_COMPAT_API_KEY=""
ANTHROPIC_API_KEY=""
DISCORD_WEBHOOK_URL=""

EXCHANGE_ID="binance"
EXCHANGE_API_KEY=""
EXCHANGE_API_SECRET=""
TELEGRAM_AUDIT_CHAT_ID=""

# Optional Studio module settings
ADMIN_EMAIL_ALLOWLIST=
BYBIT_API_KEY=
BYBIT_API_SECRET=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CMC_API_KEY=
COINGECKO_API_KEY=
COINGECKO_API_TIER=
CONTAINMENT_BINDING_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_DEMO_MODE=
OKX_PASSPHRASE=
OPERATOR_API_TOKEN=
PUBLIC_WHATSAPP_URL=
RESEND_FROM_EMAIL=
ROTATING_PROXY_POOL_URLS=
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
VITE_PUBLIC_SUPPORT_EMAIL=

# Required when NODE_ENV=production; supply via the host secret store.
SESSION_SIGNING_KEY=
